<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pump_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/widget_item_bg"
    android:padding="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/pump_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pump"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/pump_item_signal_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_signal_0" />
    </LinearLayout>

    <!-- We use multiple progress bars because we can't change progressDrawable dynamically in RemoteViews reliably on older APIs -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginBottom="12dp">

        <ProgressBar
            android:id="@+id/pump_item_progress_blue"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_blue"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_orange"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_orange"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_yellow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_yellow"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_green"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_pink"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_pink"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_purple"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_purple"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_red"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_red"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_cyan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_cyan"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_teal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_teal"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pump_item_progress_indigo"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_indigo"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pump_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pump_item_fault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#F44336"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>
            
        <TextView
            android:id="@+id/pump_item_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:gravity="end"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
